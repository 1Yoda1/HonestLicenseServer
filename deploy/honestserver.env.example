# Copy to /etc/honestserver/honestserver.env and chmod 600.
# Never commit the real file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5498
# Absolute path only. In Production the service refuses to create a database.
HONESTSERVER_SQLITE_PATH=/var/lib/honestserver/HonestLicenseFull.db

# Keep the existing production values when updating an installed server.
AdminApi__Key=REPLACE_WITH_EXISTING_PRODUCTION_KEY

# Private Cloud.ru S3 storage for diagnostic ZIP files. Never expose these keys
# to HonestFlow/HonestDesk and never commit real values.
DiagnosticStorage__ServiceUrl=https://s3.cloud.ru
DiagnosticStorage__Region=ru-central-1
DiagnosticStorage__Bucket=bucket-honestflow
DiagnosticStorage__AccessKey=REPLACE_WITH_CLOUD_RU_ACCESS_KEY
DiagnosticStorage__SecretKey=REPLACE_WITH_CLOUD_RU_SECRET_KEY
DiagnosticStorage__RetentionHours=48
DiagnosticStorage__UploadUrlMinutes=15
DiagnosticStorage__DownloadUrlMinutes=10

# Public key only. The private release-signing key stays offline.
ReleaseSigningKeys__REPLACE_KEY_ID__PublicKeyBase64=REPLACE_WITH_SUBJECT_PUBLIC_KEY_INFO_BASE64


# Preserve all existing LicenseSigningKeys__... variables on the server.

# Website intake MUST remain disabled pending owner approval and required legal steps.
ConnectionRequestPrivacy__Enabled=false
ConnectionRequestPrivacy__ApprovedDocumentVersion=
# v1.0 policy/consent are bundled byte-for-byte in the executable.
# LegalBasis defaults to Consent; versions default to 1.0. Do not override their texts.
# Approval and Enabled must be changed explicitly only after the owner confirms release.
