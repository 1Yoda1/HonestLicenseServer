# Copy to /etc/honestserver/honestserver.env and chmod 600.
# Never commit the real file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5498
ConnectionStrings__DefaultConnection="Data Source=/opt/honestserver/HonestLicenseFull.db;Mode=ReadWriteCreate;Cache=Shared"

# Keep the existing production values when updating an installed server.
AdminApi__Key=REPLACE_WITH_EXISTING_PRODUCTION_KEY

# Yandex 360 SMTP. Use an application password, not the account password.
Smtp__Host=smtp.yandex.ru
Smtp__Port=587
Smtp__Username=sdsk@morkovka.tech
Smtp__Password=REPLACE_WITH_YANDEX_APPLICATION_PASSWORD
Smtp__From=sdsk@morkovka.tech
Smtp__To=spi@morkovka.tech
Smtp__EnableSsl=true

# Preserve all existing LicenseSigningKeys__... variables on the server.
