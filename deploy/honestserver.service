[Unit]
Description=HonestLicenseServer API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=honestflow-svc
Group=honestflow-svc
WorkingDirectory=/opt/honestserver
ExecStart=/opt/honestserver/HonestLicenseServer
EnvironmentFile=/etc/honestserver/honestserver.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
ReadWritePaths=/var/lib/honestserver

[Install]
WantedBy=multi-user.target
