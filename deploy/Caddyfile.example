# Existing dedicated API hostname.
api.honestflow.ru {
    encode zstd gzip
    reverse_proxy 127.0.0.1:5498
}

# Preferred same-origin website layout. Merge this handle into the site's
# existing host block; replace the root directory with the real website path.
honestflow.ru {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:5498
    }

    handle {
        root * /var/www/honestflow
        try_files {path} /index.html
        file_server
    }
}
