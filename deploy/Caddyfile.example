# Existing dedicated API hostname.
api.honestflow.ru {
    encode zstd gzip
    reverse_proxy 127.0.0.1:5498
}

# Same-origin website layout used on the Ubuntu server.
honestflow.ru {
    encode zstd gzip

    @oldLegal path /legal /legal/ /legal/index.html
    redir @oldLegal /#pricing 301
    @oldTerms path /service-terms /service-terms/ /service-terms/index.html
    redir @oldTerms /#sla 301

    handle /api/* {
        reverse_proxy 127.0.0.1:5498
    }

    handle {
        root * /opt/honestserver/site
        try_files {path} /index.html
        file_server
    }
}

www.honestflow.ru {
    redir https://honestflow.ru{uri} permanent
}
